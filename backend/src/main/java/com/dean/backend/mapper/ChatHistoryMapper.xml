<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dean.backend.mapper.ChatHistoryMapper">

    <insert id="insertChatHistory" parameterType="ChatHistory">
        INSERT INTO chat_history (question, answer)
        VALUES (#{question}, #{answer})
    </insert>

    <select id="selectChatHistoryList" resultType="ChatHistory">
        SELECT id, question, answer, created_at AS createdAt
        FROM chat_history
        ORDER BY id DESC
    </select>


</mapper>